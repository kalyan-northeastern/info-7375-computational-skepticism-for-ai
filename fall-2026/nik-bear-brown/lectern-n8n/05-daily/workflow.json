  {
   "parameters": {
    "jsCode": "const m = $('Remember what exists').first().json, d = $('03 · Delta').first().json, p = $json;\nconst ids = [...new Set([...(m.already || []), ...(p.posted_ids || [])])].sort();\nreturn [{json: {state_path: m.state_path, posted_path: m.posted_path, next_state: d.next_state, posted_ids: ids, wrote_posted: (p.posted_ids || []).length > 0,\n  summary: {date: d.date, baseline: d.baseline, kept: d.counts.kept, new: d.counts.new, changed: d.counts.changed, gone: d.counts.gone, gone_by_reason: d.counts.gone_by_reason,\n            unavailable: d.unavailable, filter_note: d.filter_note, messages: p.messages.length, sent: p.sent_count, refused: p.refused}}}];"
   },
