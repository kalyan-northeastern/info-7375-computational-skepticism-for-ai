   "parameters": {
    "jsCode": "// The only place to edit. mode: 'fixture' replays made-up payloads; 'live' reads the real boards.\nreturn [{json: {mode: 'fixture', only: [], date: '', send: false, allow_first_run_post: false, state_path: '__STATE_PATH__', posted_path: '__POSTED_PATH__'}}];"
   },
