 "nodes": [
  {
   "parameters": {
    "content": "## 05 · Daily\nCalls 01 to 04 in order and keeps two small files: the published state and the ids already posted. Set the paths and `mode` in **Settings**. Default: fixtures, dry run (nothing sent), state written. Run it twice: the second run finds nothing new. The state advances only after the whole chain succeeded. Import all five workflows with `tools/import.sh` so the Execute Workflow nodes find their targets.",
    "height": 210,
    "width": 700,
    "color": 4
   },
   "id": "25fc060f-7b70",
   "name": "Note 05 · Daily\nCalls 01 t",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -160,
    -380
   ]
  },
  {
   "parameters": {},
